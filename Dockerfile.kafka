FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Keep in sync with requirements.txt.
RUN pip install confluent-kafka==2.16.0

RUN useradd --create-home --uid 10001 app

COPY python/kafka_order_producer.py ./kafka_order_producer.py

USER app

CMD ["python", "kafka_order_producer.py"]
